<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>sghq-nexus</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASS}</password>
        </server>
    </servers>
    <mirrors>
        <!-- Explicitly allow this trusted Docker-network repository over HTTP.
             Maven's default external HTTP blocker still applies elsewhere. -->
        <mirror>
            <id>sghq-nexus</id>
            <mirrorOf>sghq-nexus</mirrorOf>
            <url>${env.NEXUS_BASE_URL}/repository/maven-public/</url>
        </mirror>
    </mirrors>
    <profiles>
        <profile>
            <id>sghq-ci</id>
            <repositories>
                <!-- Swift publishes the legacy Spigot server dependency here. -->
                <repository>
                    <id>sghq-nexus</id>
                    <url>${env.NEXUS_BASE_URL}/repository/maven-public/</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>sghq-ci</activeProfile>
    </activeProfiles>
</settings>
